rules_version = '2';
// Firebase Storage für eigene Übungsvideos im Projekt fitness-aos.
// Nicht deployen, solange der Bucket nicht angelegt ist.
// Lesen: nur angemeldete Nutzer, wie die übrigen Firebase-Daten der App.
// Gäste bleiben beim Katalog-Video. Schreiben: nur video/*, höchstens 100 MB.
// Objekte werden nicht überschrieben und nicht gelöscht.
service firebase.storage {
  match /b/{bucket}/o {
    match /exerciseVideos/{exerciseId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exerciseId.matches('^[a-z][a-z0-9_]{0,63}$')
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$')
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.+');
      allow update, delete: if false;
    }
  }
}
