{
  "apps": {
    "6pack": {
      "name": "6Pack",
      "short": "6Pack",
      "description": "6-Pack-Programm mit Workout-Runner",
      "accent": "#e5192b",
      "register": { "expose": true, "reloadWindowMs": 0 },
      "sw": {
        "shell": ["./", "./index.html", "./manifest.webmanifest", "./icon-192.png"],
        "navTimeoutMs": 400,
        "notificationClick": false,
        "extraFile": "workoutNotificationSW.js"
      },
      "splash": {
        "minMs": 0,
        "failsafeMs": 4000,
        "updateWindowMs": 800
      }
    }
  }
}
