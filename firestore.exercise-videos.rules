rules_version = '2';
// FRAGMENT für die Zuordnung eigener Übungsvideos.
// Nicht allein deployen. Die deploybare Firestore-SSOT bleibt
// vitalos/firestore.rules und geht über VitalOS-CI. Ein Deploy dieser
// Datei als komplettes Ruleset würde alle anderen Regeln ersetzen.
//
// 1:1 übernehmen: in vitalos/firestore.rules den bestehenden Block
// „6Pack exercise videos“ inklusive exerciseVideoData/exerciseVideoOk
// durch die Funktionen und das match unten ersetzen. isCoach() ist dort
// schon definiert (Custom Claim coach, roles/{uid}.role == "coach",
// Alpha-UID) und wird nur aufgerufen. Keine zweite isCoach()-Funktion
// einfügen und keine neue Admin-Logik erfinden.
//
// Lesen: jedes angemeldete Konto (dieselbe Zuordnung für die Übung).
// Anlegen: nur wenn noch kein Dokument existiert und uploaderUid das
// eigene Konto ist.
// Ändern: nur der bisherige Uploader oder isCoach(); uploaderUid bleibt.
// Löschen: der bisherige Uploader oder isCoach().
// Feldgrenzen bleiben: bekannte Felder, Status pending oder approved,
// Dauer höchstens 60 Sekunden, Größe höchstens 100 MB.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function videoData() {
      return request.resource.data;
    }
    function isSeconds(value) {
      return value is int || value is float;
    }
    function clipOk(data) {
      return (!('clipStart' in data) && !('clipEnd' in data))
        || (
          isSeconds(data.clipStart)
          && isSeconds(data.clipEnd)
          && data.clipStart >= 0
          && data.clipEnd > data.clipStart
          && data.clipEnd - data.clipStart <= 60
          && data.clipEnd <= data.duration + 0.05
        );
    }
    function videoOk(exerciseId) {
      return signedIn()
        && exerciseId.matches('^[a-z][a-z0-9_]{0,63}$')
        && videoData().keys().hasOnly([
          'exerciseId', 'storagePath', 'uploaderUid', 'createdAt',
          'duration', 'status', 'contentType', 'sizeBytes', 'clipStart', 'clipEnd'
        ])
        && videoData().exerciseId == exerciseId
        && videoData().uploaderUid.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
        && videoData().storagePath == 'exerciseVideos/' + exerciseId + '/' + videoData().uploaderUid
        && videoData().contentType.matches('video/.+')
        && videoData().sizeBytes is int
        && videoData().sizeBytes > 0
        && videoData().sizeBytes <= 100 * 1024 * 1024
        && isSeconds(videoData().duration)
        && videoData().duration > 0
        && videoData().duration <= 60
        && videoData().status in ['pending', 'approved']
        && videoData().createdAt == request.time
        && clipOk(videoData());
    }
    match /exerciseVideos/{exerciseId} {
      allow read: if signedIn();
      allow create: if resource == null
        && videoOk(exerciseId)
        && videoData().uploaderUid == request.auth.uid;
      allow update: if resource != null
        && videoOk(exerciseId)
        && request.resource.data.uploaderUid == resource.data.uploaderUid
        && (resource.data.uploaderUid == request.auth.uid || isCoach());
      allow delete: if resource != null
        && signedIn()
        && (resource.data.uploaderUid == request.auth.uid || isCoach());
    }
  }
}
