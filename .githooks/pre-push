#!/bin/bash
# pre-push hook: build + deploy to Firebase when relevant frontend files are
# part of the push to vitalos (diese Kopie läuft bewusst auf dem Branch
# "vitalos" statt "master" — ~/vitalos/6pack-app ist eine Submodule-Kopie
# von 6pack-dev, die hier dauerhaft auf vitalos ausgecheckt ist).
#
# Runs once per push (not per ref), reads pushed refs from stdin.

cd "$(git rev-parse --show-toplevel)"

pushed_refs="$(cat)"

SKIP='\.(md|bak)$|^dist/'
# 6pack hat seinen Code im Repo-Root (kein src/): *.jsx/*.js/*.mjs/*.css im Root, catalog/ und mini-app.json zählen ebenfalls
TRIGGER='^(src/|public/|catalog/|index.html$|vite.config|package.json$|firebase.json$|mini-app.json$|scripts/mini-app-shell/|[^/]+\.(jsx|js|mjs|css)$)'

should_deploy=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  branch="${local_ref#refs/heads/}"
  [ "$branch" != "vitalos" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    changed=$(git diff-tree --no-commit-id --name-only -r "$range")
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  relevant=$(echo "$changed" | grep -Ev "$SKIP" || true)
  if echo "$relevant" | grep -Eq "$TRIGGER"; then
    should_deploy=true
  fi
done <<< "$pushed_refs"

if [ "$should_deploy" != true ]; then
  exit 0
fi

if command -v gum >/dev/null 2>&1; then
  gum log --level info "6pack-app: relevante Änderungen im Push zu vitalos — baue + deploye zu Firebase…"
else
  echo "🔍 6pack-app: relevante Änderungen im Push zu vitalos — baue + deploye zu Firebase…"
fi

pnpm run deploy
status=$?

if [ $status -ne 0 ]; then
  echo "❌ pnpm run deploy fehlgeschlagen — Push wird abgebrochen (kein halb-deployter Stand)." >&2
  echo "   Mit 'git push --no-verify' kannst du den Hook überspringen, falls das Absicht ist." >&2
  exit 1
fi

echo "✅ Deploy abgeschlossen."
exit 0
