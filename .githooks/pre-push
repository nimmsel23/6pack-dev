#!/bin/bash
# pre-push: auf `dev` ggf. Fitness-Publisher; Standalone-Live = CI auf master.
# Kein lokaler Firebase-Deploy mehr (früher Branch vitalos).

cd "$(git rev-parse --show-toplevel)"
pushed_refs="$(cat)"

should_publish_fitness=false
fitness_source_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  branch="${local_ref#refs/heads/}"
  if [ "$branch" = "dev" ]; then
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      changed=$(git diff --name-only "$(git hash-object -t tree /dev/null)" "$local_sha")
    else
      changed=$(git diff --name-only "$remote_sha" "$local_sha")
    fi
    if echo "$changed" | grep -Eq '^(catalog/exercise-videos\.yml$|[^/]+\.(jsx|js|mjs|css)$)'; then
      should_publish_fitness=true
      fitness_source_sha="$local_sha"
    fi
    if [ -n "$changed" ]; then
      echo "💡 Release: dev → master (Auto-Promote / vos-release-pr 6pack); Shell-Pin mit 6pack-release / vos-ship. Doku: ~/vitalos/docs/DEPLOYMENT.md" >&2
    fi
  fi
done <<< "$pushed_refs"

if [ "$should_publish_fitness" = true ]; then
  fitness_repo="${FITNESS_DEV_REPO:-$HOME/dev/fitness-dev}"
  publisher="$fitness_repo/scripts/publish-mini-app-to-fitness.mjs"
  if [ ! -f "$publisher" ]; then
    echo "⚠️ Fitness publisher not found at $publisher; 6Pack source sync skipped." >&2
  else
    echo "🔄 6Pack dev → Fitness dev: synchronizing the pushed source commit…"
    node "$publisher" sixpack "$fitness_source_sha" || exit $?
  fi
fi

exit 0
