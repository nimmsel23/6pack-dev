{
  "name": "6pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:data",
    "dev": "vite",
    "prebuild": "pnpm run build:data",
    "build": "vite build && node scripts/mini-app-shell/cli.mjs stamp dist --app 6pack",
    "preview": "vite preview",
    "build:data": "node build-data.mjs",
    "firebase": "firebase deploy --only hosting:sixpack",
    "publish:fitness": "node publish-fitness.mjs",
    "vendor:check": "node ~/vitalos/packages/mini-app-shell/cli.mjs vendor scripts/mini-app-shell --check",
    "build:native": "node build-data.mjs && vite build --mode native",
    "native:sync": "pnpm run build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "build:android": "pnpm run native:sync && cd android && ./gradlew assembleDebug",
    "run:android": "pnpm run native:sync && cap run android",
    "test:reminders": "TZ=Europe/Vienna node scripts/test-reminders.mjs",
    "test:calendar": "node scripts/test-calendar-reminders.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "11.10.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.3",
    "vite": "6.4.5"
  }
}
