{
  "name": "6pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:data",
    "dev": "vite",
    "prebuild": "pnpm run build:data",
    "build": "vite build && node scripts/mini-app-shell/cli.mjs stamp dist --app 6pack",
    "preview": "vite preview",
    "build:data": "node build-data.mjs",
    "firebase": "firebase deploy --only hosting:sixpack",
    "publish:fitness": "node publish-fitness.mjs",
    "vendor:check": "node ~/vitalos/packages/mini-app-shell/cli.mjs vendor scripts/mini-app-shell --check",
    "build:native": "node build-data.mjs && vite build --mode native",
    "native:sync": "pnpm run build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "build:android": "pnpm run native:sync && cd android && ./gradlew assembleDebug",
    "run:android": "pnpm run native:sync && cap run android",
    "test:embed": "node --test scripts/test-embed.mjs",
    "test:reminders": "TZ=Europe/Vienna node scripts/test-reminders.mjs",
    "test:calendar": "node scripts/test-calendar-reminders.mjs",
    "test:exercise-video": "node scripts/test-exercise-video.mjs",
    "test:update": "node --test scripts/test-app-update.mjs",
    "dev:skills": "pnpm run build:data && vite --mode skills",
    "build:skills": "pnpm run build:data && vite build --mode skills && cd skills && node ../scripts/mini-app-shell/cli.mjs stamp ../dist-skills --app skills",
    "test:skills": "node scripts/test-skills.mjs",
    "dev:video-control": "pnpm run build:data && vite --mode video-control --host 127.0.0.1 --port 5173 --strictPort",
    "build:video-control": "pnpm run build:data && vite build --mode video-control",
    "test:video-control": "node scripts/test-video-control.mjs",
    "video-control": "bash scripts/video-control.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^13.3.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.73.0",
    "mediabunny": "^1.66.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.8",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  }
}
